                dimensions: 1
                inputs: [x]
                outputs: [y]
                value: 133.76577732202026
              - !transform/constant-1.6.0
                dimensions: 1
                inputs: [x]
                outputs: [y]
                value: -7.242685816122081
              inputs: [x0, x1]
              outputs: [y0, y1]
            - !transform/tabular-1.4.0
              bounds_error: false
              inputs: [x]
